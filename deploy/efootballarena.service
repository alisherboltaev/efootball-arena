[Unit]
Description=eFootball Arena (Flarnix)
After=network.target

[Service]
User=efootball
WorkingDirectory=/opt/efootballarena
Environment=HOST=127.0.0.1
Environment=PORT=8000
ExecStart=/usr/bin/python3 /opt/efootballarena/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
